  "analysis": "does a column perturbation at the equivalence margin flip any pre-registered classification?",
  "runs_transport": false,
  "support_mask": {
    "all_rows": true,
    "n_rows": 120,
    "rationale": "synthetic nuisance blocks: all rows intentionally used, declared explicitly rather than relying on a default",
    "passed_explicitly": true
  },
  "why": "the margin was justified in words, by the two to three fold headroom of the final thresholds. That is not sufficient: the classifications come from a Schur complement of a near-singular Fisher matrix, where a small perturbation of the nuisance block can move a psi bound by much more than the perturbation, and the near-null direction is exactly what a near-singular matrix reports unstably.",
  "psi_block": {
    "source": "data/derived/production_pooled.npz",
    "sha256": "9d9cbe8a89a0488203a7ad78ec0090341e9d8849af1c027028909c34216c8194",
    "whitening": "multinomial_fixed_launch, as the headline CRB uses",
