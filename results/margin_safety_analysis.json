    "families": [
      "generic",
      "internally_collinear",
      "nearly_inside_psi_span",
      "tiny_relative_to_psi",
      "one_column_nearly_degenerate"
    ],
    "families_include_the_dangerous_regimes": "internally_collinear gives a singular F_ee so the Schur complement divides by something small; nearly_inside_psi_span drives F_psi_eff itself toward singular; tiny_relative_to_psi and one_column_nearly_degenerate probe the ill-conditioned extremes. The first version of this analysis used only the generic family, which is the safe regime, and reported the margin as safe on that basis.",
    "coupling_levels_relative_to_the_psi_block": [
      0.05,
      0.2,
      0.5,
      1.0,
      2.0
    ],
    "coupling_levels_note": "each family is built at every coupling level",
    "why_a_family": "the real eta block is unknown until the gate runs, so the question is whether the margin is safe for the blocks that could turn up. A margin unsafe for some plausible block is not a safe margin."
  },
  "perturbation": {
    "per_column_relative_size": "the margin",
    "directions_searched_per_block": 66,
    "search": "the direction that moves the deep StO2 bound the most is searched for, over the leading left singular directions of the psi block plus random directions. Random directions in a 120 by 5 space essentially never find the worst case, so a margin safe against random perturbations would be the wrong thing to report."
  },
